# Copiar esta variable en Vercel > Settings > Environment Variables.
# Es la cadena de conexión de Supabase: panel del proyecto > botón "Connect" >
# "Transaction pooler" (puerto 6543). Reemplazar [YOUR-PASSWORD] por la contraseña
# de la base. Sin agregar "?pgbouncer=true": es sólo para Prisma y psycopg la rechaza.
# Nunca subir el archivo .env a GitHub.
DATABASE_URL=postgresql://postgres.nwjvgikunyevmkeuajgu:[YOUR-PASSWORD]@aws-1-us-west-2.pooler.supabase.com:6543/postgres
