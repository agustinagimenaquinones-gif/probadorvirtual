# Copiar estas variables en Vercel > Settings > Environment Variables
# (con los datos de la base MySQL en la nube). Nunca subir el archivo .env a GitHub.
PROBADOR_MYSQL_HOST=
PROBADOR_MYSQL_PORT=3306
PROBADOR_MYSQL_USER=
PROBADOR_MYSQL_PASSWORD=
PROBADOR_MYSQL_DATABASE=probador_virtual
PROBADOR_MYSQL_SSL=1
